<?xml version="1.0" encoding="utf-8"?>
<!-- FlutterSecureStorage.xml: its values are wrapped by Keystore keys that are never backed up, so a restored copy can't be read (and holds the library key). -->
<full-backup-content>
    <exclude domain="external" path="Pictures/" />
    <exclude domain="sharedpref" path="AdaptySDKPrefs.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
