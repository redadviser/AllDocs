<?xml version="1.0" encoding="utf-8"?>
<!-- Merges the rules from cunning_document_scanner and the Adapty SDK, which clash otherwise. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="Pictures/" />
        <exclude domain="sharedpref" path="AdaptySDKPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="Pictures/" />
        <exclude domain="sharedpref" path="AdaptySDKPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
