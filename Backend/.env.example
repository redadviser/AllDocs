# AllDocs' database: accounts (users/profiles), devices, and later
# vaults/reminders/subscriptions. Tables are created on server start
# (scripts/schema.sql).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=alldocs
POSTGRES_USER=alldocs
POSTGRES_PASSWORD=alldocs!eupasoft!app!dev

# Signing secret for session tokens.
JWT_SECRET=8017ed2a724560fd0992d4529fadcdb86fc4fbe632b3931869ec67b9501a77a2af9a42e06ed19229c63459805ea4dba6b551c0147f75ca2074450262112f12c0 

# "Sign in with Google". Not yet configured — create an OAuth
# consent screen + one client per platform in Google Cloud Console, then
# fill these in. At least one must be set for the endpoint to work; all
# configured ones are accepted as valid token audiences since a client can
# sign in from any platform. See docs/architecture.md for the full checklist.
GOOGLE_SIGNIN_IOS_CLIENT_ID= 
GOOGLE_SIGNIN_ANDROID_CLIENT_ID=
GOOGLE_SIGNIN_WEB_CLIENT_ID= AIzaSyAUo7sBAn-JXwyZWWIC8XSwJp6aMB-ivKI

# Cloud connections (import + backup). Public client ids, served to the app
# by GET /api/config/cloud — the Google ones above are reused for Google
# Drive. Empty = that provider shows as "coming soon" in the app. See
# "Cloud integrations" in docs/architecture.md for how to register each.
ONEDRIVE_CLIENT_ID=
DROPBOX_APP_KEY=

# "Forgot password" emails (SMTP, any provider). Without SMTP_HOST the
# email isn't sent (in development its text is printed to the console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AllDocs <no-reply@example.com>"

# Public address of this server, used in the reset links. Defaults to the
# production URL; never taken from the request's Host header in production.
PUBLIC_URL=

NODE_ENV=development
# Swagger UI at /api/docs (set to false to hide it).
DOCS_ENABLED=true
PORT=3000
CORS_ORIGIN=
