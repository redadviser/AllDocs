# AllDocs' own database (shelves/albums/documents metadata, devices, and
# later vaults/reminders/subscriptions). Same Postgres server as AllPhotos
# in production, but a different database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=alldocs
POSTGRES_USER=alldocs
POSTGRES_PASSWORD=alldocs!eupasoft!app!dev

# Shared account identity (the `users` table only). Points at the existing
# AllPhotos database in production — AllDocs and AllPhotos share a login,
# but never share app-specific data. The values below match the local
# `docker-compose.yml`, which seeds a throwaway `allphotos` database with
# just a `users` table (scripts/accounts-schema.sql) for local testing.
ACCOUNTS_POSTGRES_HOST=localhost
ACCOUNTS_POSTGRES_PORT=5433
ACCOUNTS_POSTGRES_DB=allphotos
ACCOUNTS_POSTGRES_USER=alldocs
ACCOUNTS_POSTGRES_PASSWORD=alldocs!eupasoft!app!dev

# Own signing secret — never shared with AllPhotos. A token issued by one
# app's backend must never be valid on the other.
JWT_SECRET=8017ed2a724560fd0992d4529fadcdb86fc4fbe632b3931869ec67b9501a77a2af9a42e06ed19229c63459805ea4dba6b551c0147f75ca2074450262112f12c0 

# "Sign in with Google" (AllID). Not yet configured — create an OAuth
# consent screen + one client per platform in Google Cloud Console, then
# fill these in. At least one must be set for the endpoint to work; all
# configured ones are accepted as valid token audiences since a client can
# sign in from any platform. See docs/architecture.md for the full checklist.
GOOGLE_SIGNIN_IOS_CLIENT_ID=
GOOGLE_SIGNIN_ANDROID_CLIENT_ID=
GOOGLE_SIGNIN_WEB_CLIENT_ID=

NODE_ENV=development
PORT=3000
CORS_ORIGIN=
